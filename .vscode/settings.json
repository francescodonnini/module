{
    "[c]":   { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd", "editor.formatOnSave": true },
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--background-index",
        "--header-insertion=never",
        "--completion-style=detailed",
        "--query-driver=/usr/bin/gcc"
    ],
    "files.associations": {
        "*.h": "c",
        "Kbuild": "makefile",
        "**/Kbuild": "makefile"
    },
    "makefile.configureOnOpen": false
}